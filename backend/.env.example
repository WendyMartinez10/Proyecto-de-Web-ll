# Configuración del servidor
PORT=4000

# Configuración de MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=UTN_Marcas_y_Registros

# Secreto usado para firmar la cookie de sesión
# En desarrollo puedes colocar uno aleatorio.
SESSION_SECRET=mi_clave_secreta_para_sesiones_2026

# Frontend
CORS_ORIGIN=http://localhost:5173

# Archivos subidos
UPLOADS_DIR=uploads/equipos

# Rango de IP permitido
IP_RANGO_PERMITIDO=0.0.0.0/0

# Tamaño máximo de archivo
