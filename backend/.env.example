# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio (ya está en .gitignore).

PORT=4000

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=marcas_equipos

# Secreto usado para firmar la cookie de sesión. Debe ser aleatorio, largo
# y distinto en cada entorno (desarrollo, staging, producción).
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=uploads/equipos
IP_RANGO_PERMITIDO=0.0.0.0/0

# Valor de respaldo del tamaño máximo de archivo (MB) si la configuración
# dinámica en la tabla `configuracion` (clave tamano_max_archivo_mb) no
# está disponible.
MAX_FILE_SIZE_MB_FALLBACK=5

# En producción, detrás de HTTPS, poner en true.
COOKIE_SECURE=false
# Poner en true solo si la app corre detrás de un reverse proxy (nginx, etc.)
# que termina TLS.
TRUST_PROXY=false

# URL del frontend, usada para construir el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Configuración SMTP para el envío real de correos (recuperación de contraseña).
# Si SMTP_HOST/SMTP_USER/SMTP_PASS quedan vacíos, el enlace se registra en
# consola en lugar de enviarse (modo de desarrollo). No uses la contraseña
# normal de la cuenta: usa una "contraseña de aplicación" o credenciales de
# un proveedor transaccional (SendGrid, Mailgun, SES, etc.).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Marcas y Equipos <no-reply@marcas-equipos.local>"
